#!/bin/bash
#
# This file is sourced by sdm for the burn and shrink commands
# It is not callable by anything other than sdm
# because it needs access to a bazillion variables defined
# in sdm, so can only run in the context of sdm. 
#
function loadparams() {
    local arg="$1"
    source $SDMPT/etc/sdm/sdm-readparams $arg
}

function write_burnmsg() {
    #
    # $1 has the message to write
    # $2 unused
    # $3 has mods [notty]
    # this so it can be called the same as logtoboth
    # It's written to the terminal and added to burnmsg
    #
    local msg="$1" mods="$3"
    if [[ "$SDMPT" != "" ]] && [[ $fpartcopy -eq 0 ]]
    then
	if ismounted $SDMPT && [[ -f $SDMPT/etc/sdm/history ]]
	then
	    logtoboth "$msg"
	else
	    burnmsg+=("$(thisdate) $msg")
	    [[ "$mods" =~ notty ]] || echo "$msg"
	fi
    else
	burnmsg+=("$(thisdate) $msg")
	[[ "$mods" =~ notty ]] ||echo "$msg"
    fi
    return 0
}    

function ddctrlc() {
    printf "\n%% Caught CTRL/C during burn. Cleaning up...\n"
    if [ "$ddpid" != "" ]
    then
	kill -HUP $ddpid >/dev/null 2>&1
	wait $ddpid >/dev/null 2>&1
	exit 1
    fi
}

function alignpartition() {
    local s=$1      # original start sector
    local u=$2      # alignment unit in sectors
    echo $(( ( (s + u - 1) / u ) * u ))
}

function setdiskid() {
    local dev="$1" diskid="$2"
    sfdisk --disk-id $dev 0x${diskid}
    if [ $? -ne 0 ]    # Assume it's an older version of sfdisk without --disk-id if it fails
    then
	write_burnmsg "% sfdisk failed; Trying fdisk to set Disk ID"
        fdisk $dev >/dev/null <<EOF
x
i
0x$diskid
r
w
EOF
        errifrc $? "? fdisk error '$?'"
	write_burnmsg "> Disk ID '$diskid' set successfully with fdisk"
    else
	write_burnmsg "> Disk ID '$diskid' set successfully with sfdisk"
    fi
}

function writediskids() {
    local gptuuid1 gptuuid2

    if [ -f $SDMPT/boot/firmware/cmdline.txt ]
    then
	if [ $fgpt -eq 0 ]
	then
	    write_burnmsg "> Set MBR rootfs partition ID '0x$newdiskid' in cmdline.txt (was '0x$olddiskid')"
	    sed -i "s/${olddiskid}/${newdiskid}/" $SDMPT/boot/firmware/cmdline.txt
	else
	    gptuuid1=$(blkid $(getspname $burndev 1) | sed -n 's|^.*PARTUUID="\(\S\+\)".*|\1|p')
	    gptuuid2=$(blkid $(getspname $burndev 2) | sed -n 's|^.*PARTUUID="\(\S\+\)".*|\1|p')
	    if [ "$cvtrootfs" == "lvm" ]
	    then
		write_burnmsg "> Set GPT rootfs '$mapper' in cmdline.txt"
		sed -i "s|root=PARTUUID=${olddiskid}-02|root=$mapper|" $SDMPT/boot/firmware/cmdline.txt
		gptpart2=$mapper
	    else
		write_burnmsg "> Set GPT rootfs partition GUID '$gptuuid2' in cmdline.txt"
		sed -i "s/${olddiskid}-02/$gptuuid2/" $SDMPT/boot/firmware/cmdline.txt
		gptpart2="PARTUUID=$gptuuid2"
	    fi
	fi
	# init_resize disappeared in 2022-09-06 build, not in systems with /boot/firmware
    elif [ -f $SDMPT/boot/cmdline.txt ]
    then
	write_burnmsg "> Set new Disk ID '$newdiskid' in /etc/fstab and /boot/cmdline.txt"
	sed -i "s/${olddiskid}/${newdiskid}/" $SDMPT/boot/cmdline.txt
	# Quirks not there in bullseye or bookworm, but keep for posterity
	#sed -i 's| sdhci\.debug_quirks2=4||' $SDMPT/boot/cmdline.txt
    fi
    if [ $fgpt -eq 0 ]
    then
	write_burnmsg "> Set MBR partition Disk IDs in fstab"
	sed -i "s/${olddiskid}/${newdiskid}/g" $SDMPT/etc/fstab
    else
	write_burnmsg "> Set GPT partition GUIDs in fstab"
	sed -i "s/${olddiskid}-01/$gptuuid1/" $SDMPT/etc/fstab
	sed -i "s|PARTUUID=${olddiskid}-02|$gptpart2|" $SDMPT/etc/fstab
    fi
}

function copybypart() {
    #
    # Copy the partitions one at a time and change rootfs format
    #
    local srcdev="$1" dstdev="$2" dsttype="${3:-dos}" fstype="${4:-ext4}" fsext="$5" mopts="$6"
    local fatnum fatstart fatend fatsize
    local extnum extstart extend extsize extext
    local misc p1 p2 rootfs

    p1=$(getpartname $dstdev 1)
    p2=$(getpartname $dstdev 2)
    while read line
    do
	if [[ "$line" =~ "msdos" ]] || [[ "$line" =~ "fat32" ]]
	then
            IFS=":" read fatnum fatstart fatend fatsize misc <<< $line
	elif [[ "$line" =~ "ext4" ]]
	then
            IFS=":" read extnum extstart extend extsize misc <<< $line
	fi
    done < <(parted --machine --script $srcdev unit S print)

    if [[ "$fatnum" == "" ]] || [[ "$extnum" == "" ]]
    then
	errexit "? Expected partitions not found on $srcdev"
    fi

    #declare -x SDMPT=$(makemtpt)
    #declare -x SDMPX=$(makemtptX)
    domount $srcdev IMG $SDMPX

    #
    # Derive new rootfs size if specified with --convert-root fstype,size
    #
    devdev=${dstdev##/dev/}
    devsize=$(cat /sys/block/$devdev/size)         # 512byte blocks
    if [[ "$fsext" != "" ]]
    then
	extext=${fsext#+}
	extextsectors=$((extext*2048)) #1024*1024/512 to get sectors
	if [[ "$fsext" =~ "+" ]]
	then
	    extend="$((${extend%s}+extextsectors))s"
	    write_burnmsg "> Increase rootfs size by ${extext}MB per '--convert-root $fstype,$fsext'"
	else
	    write_burnmsg "> Burn rootfs to ${extext}MB per '--convert-root $fstype,$fsext'"
	    extend=$((${extstart%s}+extextsectors))s
	fi
    else
	if [ "$fstype" == "zfs" ]
	then
	    # This is pretty horrible
	    sdmptsave=$SDMPT
	    declare -x SDMPT=$SDMPX
	    loadparams x # Read settings from source IMG (names prefixed by 'x')
	    declare -x SDMPT=$sdmptsave
	    yexpandroot=$((xexpandroot|expandroot))
	    ynoexpandroot=$((xfnoexpandroot|fnoexpandroot))
	    [ $ynoexpandroot -eq 1 ] || ispluginselected cryptroot "${plugins}~${allplugins}" && yexpandroot=0
	    if [ $yexpandroot -eq 1 ]
	    then
		devsize=$((devsize-(33*2)))            # Eliminate sgdisk -p 33 'block' complaint
		[ "$fstype" == "zfs" ] && devsize=$((devsize-320*(1024*1024)/512))
		extend=${devsize}s
		write_burnmsg "> Root partition '$(getspname $dstdev 2)' ($fstype) on device '$dstdev' will be created to $(getgbstr $((devsize*512)))"
	    fi
	fi
    fi

    #
    # Delete old partitions on destination and set disk label type
    # If lvm on the disk then delete it
    #
    write_burnmsg "> Remove partitions on $dstdev"
    [ "$(lvmfind $dstdev pv)" != "" ] && lvmdelete $dstdev >/dev/null 2>&1
    # Just in case
    wipefs --all ${dstdev}$p1 >/dev/null 2>&1
    wipefs --all ${dstdev}$p2 >/dev/null 2>&1
    sgdisk --zap-all $dstdev >/dev/null 2>&1
    partprobe_wait ${dstdev}$p1

    if [ "$dsttype" == "dos" ] && [ $falign -eq 1 ]
    then
	write_burnmsg "> Align partitions for optimal performance on '$dstdev'"
	opt_bytes=$(cat "/sys/block/$devdev/queue/optimal_io_size")
	phy_bytes=$(cat "/sys/block/$devdev/queue/physical_block_size")
	# Fallback if optimal_io_size is 0 (many devices do this)
	[ "$opt_bytes" -eq 0 ] && opt_bytes="$phy_bytes"
	# Convert bytes to sectors (assuming 512-byte logical sectors)
	align_unit_s=$((opt_bytes/512))
	[ $align_unit_s -eq 0 ] && align_unit_s=2048   # fallback: 1MiB
	#write_burnmsg ">DD devsize:$devsize fatstart:$fatstart fatend:$fatend extstart:$extstart extend:$extend"
	fatstart=$(alignpartition "${fatstart%s}" $align_unit_s)s
	fatend=$((${fatstart%s} + ${fatsize%s} - 1))s
	extstart=$(alignpartition $(intmax ${extstart%s} $((${fatend%s}+1))) $align_unit_s)s
	extend=$((${extstart%s} + ${extsize%s} - 1))s
	#write_burnmsg ">DD devsize:$devsize fatstart:$fatstart fatend:$fatend extstart:$extstart extend:$extend"
    fi

    if [ "$dsttype" == "dos" ]
    then
	write_burnmsg "* Create MBR partition table on $dstdev"
	echo "label:$dsttype" | sfdisk --force $dstdev >/dev/null 2>&1 || errexit "? Error '$?' creating label on $dstdev"
	write_burnmsg "> Create fat32 partition: ${fatstart} ${fatend} on $dstdev"
	parted -s $dstdev mkpart primary fat32 ${fatstart} ${fatend} || errexit "? Error '$?' creating boot partition on $dstdev"
	write_burnmsg "> Create ext4 partition: ${extstart} ${extend} on $dstdev"
	parted -s $dstdev mkpart primary ext4 ${extstart} ${extend} || errexit "? Error '$?' creating root partition on $dstdev"
	write_burnmsg "> Set new disk ID '$newdiskid' on '$burndev'"
	setdiskid $dstdev $newdiskid
    else
	write_burnmsg "> Create GPT partition table on $dstdev"
	parted -s $dstdev mklabel gpt || errexit "? Error '$?' creating label on $dstdev"
	write_burnmsg "> Create fat32 partition 1: ${fatstart} ${fatend} on $dstdev"
	sgdisk --new 1:$fatstart:$fatend $dstdev >/dev/null || errexit "? Error '$?' creating boot partition on $dstdev"
	sgdisk --typecode 1:0700 $dstdev >/dev/null || errexit "? Error '$?' modifying partition 1 type on $dstdev"
	[ "$fstype" == "zfs" ] && { tc="bf00" ; tn="Solaris root FS (zfs)" ; }  || { tc="8300" ; tn="Linux FS ($fstype)" ; }
	write_burnmsg "> Create $tn partition 2: Start: ${extstart} End: ${extend} on $dstdev"
	sgdisk --new 2:$extstart:$extend $dstdev --typecode 2:$tc >/dev/null ||	errexit "? Error '$?' creating root partition on $dstdev"
    fi
    partprobe_wait ${dstdev}$p1

    write_burnmsg "> Create bootfs file system on $dstdev"
    mkfs.vfat -F 32 ${dstdev}$p1 #>/dev/null 2>&1 || errexit "? Error '$?' creating bootfs file system on $dstdev"
    rootdev=${dstdev}$p2
    rootfs=$rootdev
    case "$fstype" in
	ext4)
	    write_burnmsg "> Create 'ext4' rootfs file system on $rootdev"
	    mkfs.ext4 -F ${dstdev}$p2 >/dev/null 2>&1 || errexit "? Error '$?' creating ext4 rootfs file system on $dstdev"
	    ;;
	btrfs)
	    write_burnmsg "> Create 'btrfs' rootfs file system on $rootdev"
	    mkfs.btrfs -f ${dstdev}$p2 >/dev/null || errexit "? Error '$?' creating btrfs rootfs file system on $dstdev"
	    ;;
	lvm)
	    rootfs="/dev/$vgname/rootfs"
	    write_burnmsg "> Create 'lvm' rootfs file system on $rootdev"
	    parted -s $dstdev set 1 boot on || errexit "? Error '$?' setting partition 1 'boot on' on $rootdev"
	    parted -s $dstdev set 2 lvm on || errexit "? Error '$?' setting partition 2 'lvm on' on $rootdev"
	    lvremove $rootfs --yes >/dev/null 2>&1
	    vgremove /dev/$vgname --yes >/dev/null 2>&1
	    pvremove $rootdev --yes >/dev/null 2>&1
	    partprobe_wait ${dstdev}$p2
	    write_burnmsg "> Create LVM physical volume: pvcreate $rootdev"
	    pvcreate $rootdev --force --force --yes || errexit "? Error '$?' initializing partition 2 lvm on $dstdev"
	    write_burnmsg "> Create LVM volume group: vgcreate $vgname $rootdev"
	    vgcreate $vgname $rootdev --force --force --yes || errexit "? Error '$?' creating volume group '$vgname' on $dstdev"
	    write_burnmsg "> Create LVM logical volume: lvcreate --name rootfs $vgname"
	    lvcreate --name rootfs -l 100%FREE $vgname --yes || errexit "? Error '$?' creating logical volume $(basename $rootfs) in volume group $(hostname) on $dstdev"
	    sgdisk --mbrtogpt --typecode 1:0700 $dstdev >/dev/null || errexit "? Error '$?' modifying partition 1 type on $dstdev"
	    partprobe_wait ${dstdev}$p1
	    write_burnmsg "> Create 'ext4' rootfs file system on $rootfs"
	    mkfs.ext4 -F $rootfs >/dev/null 2>&1 || errexit "? Error '$?' creating ext4 rootfs file system on $rootfs"
	    ;;
	zfs)
	    write_burnmsg "> Create 'zfs' rootfs file system on $rootdev"
	    rpool=sdmpt   # Change name to zsdm or sdmzfs or something else

	    zpool create -f \
		  -o ashift=12 \
		  -O compression=lz4 \
		  -O acltype=posixacl \
		  -O xattr=sa \
		  -O relatime=on \
		  -O mountpoint=none \
		  -O normalization=formD \
		  -O canmount=off \
		  $rpool $rootfs || logtobothex "? zpool create $rpool $rootfs failed '$?'"
	    zfs create -o mountpoint=none $rpool/ROOT || logtobothex "? zfs create $rpool/ROOT failed '$?'"
	    zfs set canmount=off $rpool/ROOT || logtobothex "? zfs set set canmount=off $rpool/ROOT failed '$?'"
	    zfs create -o mountpoint=none $rpool/ROOT/pi || logtobothex "? zfs create $rpool/ROOT/pi failed '$?'"
	    for dn in home root var srv
	    do
		zfs create -o mountpoint=legacy $rpool/$dn || logtobothex "? zfs create $rpool/$dn failed '$?'"
	    done
	    zfs set mountpoint=$SDMPT $rpool/ROOT/pi || logtobothex "? zfs mount failed '$?'"
	    write_burnmsg "> zfs dataset $rpool/ROOT/pi mounted on $SDMPT"
	    mkdir -p $SDMPT/{home,root,var,srv}
	    for dn in home root var srv
	    do
		mount -t zfs $rpool/$dn $SDMPT/$dn || logtobothex "? zfs mount $rpool/$dn failed '$?'"
	    done
	    mkdir -p --mode 755 $SDMPT/boot/firmware
	    write_burnmsg "> Configure zfs pool cachefile during sdm FirstBoot"
	    z0script="/etc/sdm/0piboot/010-zfs-cachefile.sh"
	    cat > $z0script <<EOF
#!/bin/bash
logger "FirstBoot: Enable zfs pool cachefile"
zpool set cachefile=/etc/zfs/zpool.cache sdmpt
update-initramfs -u
EOF
	    ;;
	*)
	    errexit "? Unrecognized fstype '$fstype'"
	    ;;
    esac

    [ -d $SDMPX/boot/firmware ] && msdir="$SDMPX/boot/firmware" || msdir="$SDMPX/boot"
    [ -d $SDMPX/boot/firmware ] && mddir="$SDMPT/boot/firmware" || mddir="$SDMPT/boot"
    # Create the bootfs so domount works
    if [ "$fstype" != "zfs" ]
    then
	mount $rootfs $SDMPT
	mkdir -p $mddir
	umount $SDMPT
    fi

    domount $dstdev "Device" $SDMPT $fstype "$mopts"
    write_burnmsg "> Copy bootfs to $dstdev"
    rsync -aH $msdir/ $mddir || errexit "? Error '$?' copying bootfs partition to $dstdev"

    write_burnmsg "> Copy rootfs to $dstdev"
    rsync -aH $SDMPX/ $SDMPT || errexit "? Error '$?' copying rootfs partition to $dstdev"
    sync ; sync
    case "$fstype" in
	zfs)
	    for dn in home root var srv
	    do
		echo "$rpool/$dn	/$dn	zfs	defaults	0	0" >> $SDMPT/etc/fstab
	    done
	    ;;
    esac

    #dbgshell "** After copies done"
    write_burnmsg "> rootfs copy complete"
}

function sdm_burndevfile() {

    # Stash burn messages in an array until log on SD Card is mounted and available 
    declare -x SDMNSPAWN="Burn0"
    declare -a burnmsg
    fpartcopy=0
    write_burnmsg "* Start Burn"
    loginfo write_burnmsg "$cmdline" "" notty
    burnstart="$(getcdate)"
    newdiskid="$(printf  "%08x" "$(((RANDOM*RANDOM*RANDOM*RANDOM+RANDOM)&0xFFFFFFFF))")"
    if [ $burn -eq 1 ]
    then
	#
	# Burning to a device
	#
	[ "$burndev" == "" ] && errexit "? No storage device specified"
	[ ! -b $burndev ] && errexit "? '$burndev' is not a block device"
	perr=0
	for p in 1 2 3 4 5 6 7 8
	do
	    pdev="$(getpartname $burndev $p)"
	    ismounted ${burndev}${pdev} && echo "? Partition ${burndev}${pdev} is mounted" && perr=1
	done
	[ $perr -eq 1 ] && errexit "? Use 'sudo umount' to unmount each mounted partition, then redo the burn command"
	notmounted $burndev || errexit "? Device '$burndev' is mounted"   # one last check
	! sfdisk -l $burndev >/dev/null 2>&1 && errexit "? Cannot access '$burndev'; is there a disk in the drive?"
	bsize=$(stat --printf %s $dimg)
	write_burnmsg "* Burn '$dimg' $(getgbstr $bsize) to '$burndev'..."
	diskbytes=$(getdiskbytes $burndev)
	if [[ $fgpt -eq 0 ]] && [[ $diskbytes -ge 2000000000000 ]]  # Force most 2TB disks to GPT
	then
	    write_burnmsg "% Convert disk '$burndev' (>=2TB) to GPT"
	    fgpt=1
	    [ "$cvtrootfs" == "" ] && cvtrootfs=ext4
	fi
	olddiskid="$((blkid -o value $dimg) | (read id ; echo $id))"
	if [ "$cvtrootfs" == "" ]
	then
	    ddcmd="dd if=$dimg of=$burndev status=progress $ddsw"
	    write_burnmsg "> dd command: $ddcmd"
	    # Burn the IMG to the device but zero first and last blocks first
	    zero1stlast $burndev
	    trap "ddctrlc" SIGINT
	    $ddcmd &
	    ddpid=$!
	    wait $ddpid >/dev/null 2>&1
	    [ $? -ne 0 ] && errexit "? Exiting due to dd error"
	    trap SIGINT
	    write_burnmsg "> dd Copy completed"
	    sync ; sleep 1 ; sync
	    if [ $fgpt -eq 0 ]
	    then
		write_burnmsg "> Set new disk ID '$newdiskid' on '$burndev'"
		setdiskid $burndev $newdiskid
	    else
		write_burnmsg "> Convert disk '$burndev' to GPT"
		sgdisk --mbrtogpt --randomize-guids $burndev >/dev/null 2>&1 || errexit "? Error '$?' converting MBR to GPT"
		write_burnmsg "> Set boot partition boot code 0c on '$burndev'"
		gdisk $burndev <<EOF &>/dev/null
r
h
1
n
0c
n
n
w
y
EOF
		errifrc $? "? Error '$?' Setting MBR hex code"
	    fi
	else
	    [ $fgpt -eq 0 ] && pt=dos || pt=gpt
	    declare -x SDMPT=$(makemtpt)
	    declare -x SDMPX=$(makemtptX)
	    [ "$hname" == "" ] && vgname="vg1" || vgname=$hname
	    mapper="/dev/mapper/$vgname-rootfs"
	    fpartcopy=1
	    copybypart $dimg $burndev $pt $cvtrootfs "$cvtrootext" "$cvtrootmountoptions"
	    #dbgshell "** After copybypart"
	    fpartcopy=0
	    docleanup
	    #dbgshell "** After copybypart/docleanup"
	    sync ; sleep 1 ; sync
	fi
	partprobe_wait $burndev
	sync ; sleep 0.25 ; sync
	#dbgshell "** before domount"
	declare -x SDMPT=$(makemtpt)
	domount "$burndev" "Device" $SDMPT $cvtrootfs "$cvtrootmountoptions"
	#dbgshell "** After domount $burndev"
    else
	#
	# Burning to a file
	#
	[ "$burnfilefile" == "" ] && errexit "? No Output IMG file specified"
	[ -f $burnfilefile ] && errexit "? Output IMG file '$burnfilefile' exists"
	bsize=$(stat --printf %s $dimg)
	write_burnmsg "* Burn '$dimg' $(getgbstr $bsize) to IMG '$burnfilefile'..."
	burnmsg+=("$(thisdate) > Burn IMG command line: $cmdline")
	# cp will fail if not on a COW (btrfs) file system
	cp --reflink=always $dimg $burnfilefile 2>/dev/null
	if [ $? -eq 0 ]
	then
	    burnmsg+=("$(thisdate) > Burn IMG using 'cp' on copy-on-write file system")
	else
	    ddcmd="dd if=$dimg of=$burnfilefile status=progress $ddsw"
	    write_burnmsg "> dd command: $ddcmd"
	    # Burn the IMG to the file
	    #echo "$ddcmd"
	    trap "ddctrlc" SIGINT
	    $ddcmd &
	    ddpid=$!
	    wait $ddpid >/dev/null 2>&1
	    [ $? -ne 0 ] && errexit "? Exiting due to dd error"
	    trap SIGINT
	    write_burnmsg "> Image copy completed"
	fi
	olddiskid="$((blkid -o value $burnfilefile) | (read id ; echo $id))"
	loopdev=$(losetup --show -P -f $burnfilefile)
	sync ; sleep 1 ; sync
	write_burnmsg "> Set new disk ID '$newdiskid' on '$burnfilefile'"
	setdiskid $loopdev $newdiskid
	losetup -d $loopdev
	sync ; sleep 1 ; sync
	declare -x SDMPT=$(makemtpt)
	domount "$burnfilefile" "IMG" $SDMPT $cvtrootfs "$cvtrootmountoptions"
	expandroot=1           # Force Expand Root into the newly written IMG so it will happen when burned to something with sdm
    fi
    #
    # Write out the accumulated messages into mounted image if image has been customized
    #
    if [ -d $SDMPT/etc/sdm ]
    then
	#write_burnmsg "> Flush accumulated burn log messages"
	for (( i=0 ; i < ${#burnmsg[@]} ; i++ ))
	do
	    echo "${burnmsg[$i]}" >> $SDMPT/etc/sdm/history
	done
	#
	# Burn messages are written, all further messages written with logtoboth, which will write them to the terminal
	# and to $SDMPT/etc/sdm/history in the mounted image or image file
	#
	loadparams x  # Load params from burned IMG prefixed with 'x'
	              # and update current settings from burned IMG
	[ "$aptcache" == "" ] && aptcache=$xaptcache
	aptdistupgrade=$((aptdistupgrade|xaptdistupgrade))
	expandroot=$((expandroot|xexpandroot))
	fchroot=$((fchroot|xfchroot))
	fexpandatboot=$((expandatboot|xexpandatboot))
	fnoexpandroot=$((fnoexpandroot|xfnoexpandroot))
	regensshkeys=$((regensshkeys|xregensshkeys))
	nowaittimesync=$((nowaittimesync|xnowaittimesync))
	plugindebug=$((plugindebug|xplugindebug))
	reboot=$((reboot|xreboot))
	[ $rebootwait -eq $drebootwait ] && rebootwait=$xrebootwait
	#
	# Copy other important args from cparams in IMG to current
	#
	for pn in allplugins aptcache aptdistupgrade autologin csrc datefmt debugs domain \
			     ecolors logwidth myuser raspiosver reboot rebootwait showapt src \
			     timezone virtmode xspdev custom1 custom2 custom3 custom4
	do
	    xpn=x${pn}
	    [ "${!pn}" == "" ] && printf -v "$pn" "%s" "${!xpn}"
	done

	[ "$hname" == "" ] && write_burnmsg "% hostname not specified with --host; will not be written"
	# --bupdate must specified on the burn command line
	initvirt logtoboth  # Must be done after fchroot is set
	[ "$bupdate" != "" ] && checkupdsdm update "$bupdate" || checkupdsdm check "$bupdate"
	if ispluginselected parted "$burnplugins"
	then
	    write_burnmsg "> Force --no-expand-root per parted burn-plugin"
	    fnoexpandroot=1
	fi
	if [ $fnoexpandroot -eq 1 ]
	then
	    [ $regensshkeys -eq 0 ] && ! ispluginselected sshhostkey "${plugins}~${allplugins}" && { write_burnmsg "> Force --regen-ssh-host-keys for --no-expand-root" ; regensshkeys=1 ; }
	elif [[ $expandroot -eq 1 ]] && [[ "$burndev" != "" ]]
	then
	    if [[ "$cvtrootfs" == "" ]] || [[ "ext4|btrfs|lvm" =~ "$cvtrootfs" ]] || ! ispluginselected cryptroot "${plugins}~${allplugins}"
	    then
		docleanup keep
		expandpartition $burndev 0 logtoboth $cvtrootfs
	    elif [[ $expandroot -eq 1 ]]
	    then
		write_burnmsg "> rootfs expansion will be done after rootfs encryption completes"
	    fi
	fi
	writediskids
	ispluginselected sshhostkey "${plugins}~${allplugins}" && sshhostkey=1 || sshhostkey=0
	[ $sshhostkey -eq 1 ] && regensshkeys=1   # For this test VV
	if  [ $fexpandatboot -eq 1 ]
	then
	    write_burnmsg "> Rootfs will be expanded during first system boot"
	else
	    if [[ $((fnoexpandroot|expandroot)) -eq 1 ]] && [[ $regensshkeys -eq 1 ]]
	    then
		if [ -f $SDMPT/boot/firmware/cmdline.txt ] # Bookworm + later
		then
		    if grep -q 'init=' $SDMPT/boot/firmware/cmdline.txt
		    then
			write_burnmsg "> Disable unneeded RasPiOS firstboot service and /etc/init.d/resize2fs_once"
			sed -i 's| init=/usr/lib/raspberrypi-sys-mods/firstboot||' $SDMPT/boot/firmware/cmdline.txt
		    fi
		    if grep -q 'resize' $SDMPT/boot/firmware/cmdline.txt
		    then
			write_burnmsg "> Remove 'resize' from cmdline.txt per sdm expanding rootfs"
			sed -i 's| resize||' $SDMPT/boot/firmware/cmdline.txt
		    fi
		elif [ -f $SDMPT/boot/cmdline.txt ]   # Pre-bookworm
		then
		    sed -i 's| init=/usr/lib/raspberrypi-sys-mods/firstboot||' $SDMPT/boot/cmdline.txt
		fi
		[ -f $SDMPT/etc/init.d/resize2fs_once ] && mv $SDMPT/etc/init.d/resize2fs_once $SDMPT/etc/init.d/.sdm.resize2fs_once
	    else
		write_burnmsg "> RasPiOS firstboot service not disabled; at least one of --expand-root and --regen-ssh-host-keys not set"
	    fi
	fi
	case "$cvtrootfs" in
	    btrfs)
		write_burnmsg "> Set file system type 'btrfs' in cmdline.txt and /etc/fstab"
		sed -i 's/ext4/btrfs/' $SDMPT/etc/fstab
		sed -i 's/ext4/btrfs/' $SDMPT/boot/firmware/cmdline.txt
		;;
	    zfs)
		write_burnmsg "> Configure zfs file system in cmdline.txt and adjust /etc/fstab"
		sed -i 's%root=.*rootwait%root=ZFS=sdmpt/ROOT/pi rootwait%' $SDMPT/boot/firmware/cmdline.txt
		sed -i.bak '/PARTUUID=.*\/.*ext4.*/s/^/# /' $SDMPT/etc/fstab

		;;
	esac

	if [ $regensshkeys -eq 1 ]
	then
	    msg="> Disable regenerate_ssh_host_keys/sshd-keygen service(s)"
	    if [ $sshhostkey -eq 0 ]
	    then
		msg="${msg}; sdm FirstBoot will run it instead"
	    else
		msg="${msg} per sshhostkey plugin"
		regensshkeys=0   #Written to config below; firstboot will not regen again
	    fi
	    write_burnmsg "$msg"
	    [ -f $SDMPT/lib/systemd/system/regenerate_ssh_host_keys.service ] && sdm_runspawncmd Burn1 run-command-quietly "systemctl disable regenerate_ssh_host_keys"
	    [ -f $SDMPT/lib/systemd/system/sshd-keygen.service ] && sdm_runspawncmd Burn1 run-command-quietly "systemctl disable sshd-keygen"
	    #[ $sshhostkey -eq 0 ] && rm -f $SDMPT/etc/ssh/ssh_host_*_key* #Remove any existing keys
	    touch $SDMPT/etc/ssh/sshd_not_to_be_run
	fi
	#
	# Set hostname into the image
	#
	[ "$hname" != "" ] && updatehostname $hname

	#if [[ "$loadllocal" =~ "|wifi|" ]]
	#then
	    #[ "$wificountry" == "" ] && write_burnmsg "% No --wifi-country specified with --loadlocal wifi; Using 'US' for a short time" && wificountry="US"
	#fi
	if [ "$bkeymap" != "" ]
	then
	    write_burnmsg "> Load Keymap '$keymap' to set during FirstBoot"
	    keymap=$bkeymap
	fi
	if [ "$b1script" != "" ]
	then
	    if [ -f $b1script ]
	    then
		if [ ! -f $SDMPT/etc/sdm/assets/$(basename $b1script) ]
		then
		    write_burnmsg "> Copy '$b1script' to /etc/sdm/assets"
		    cp -a $b1script $SDMPT/etc/sdm/assets
		    setfileownmode $SDMPT/etc/sdm/assets/$(basename $b1script) 755
		fi
	    else
		if [ ! -f $SDMPT/etc/sdm/assets/$(basename $b1script) ]
		then
		   write_burnmsg "? --b1script '$b1script' not found"
		   b1script=""
		fi
	    fi
	fi
	hostname="$hname"         # So it gets written to updated params on SD card
	[ $bootscripts -eq 1 ] && state="enabled" || state="disabled"
	write_burnmsg "> First System Boot Custom Boot Scripts $state"
	[ $rebootwait -ne $drebootwait ] && wmsg=" with a $rebootwait second wait" || wmsg=""
	[ $reboot -eq 1 ] && state="enabled${wmsg}" || state="disabled"
	write_burnmsg "> First System Boot automatic restart $state"
	writeconfig               # Write updated params to the SD card so they are available in the following and at boot
	if [ "$b0script" != "" ]
	then
	    write_burnmsg "> Execute function 'do_b0script' in --b0script '$b0script'"
	    source $b0script
	    ftype=$(type -t do_b0script)
	    [ "$ftype" == "function" ] && do_b0script || write_burnmsg "% Function 'do_b0script' not found in '$b0script'; Skipping..."
	fi
	if [ "$plugins" != "" ]
	then
	    plugin_logorder "$plugins"
	    runplugins_exit "$plugins" 0
	fi

	[ -d $SDMPT/etc/lightdm ] && xldm=1 || xldm=0

	if [ "$b1script" != "" ]
	then
	    write_burnmsg "> Run --b1script '$b1script'"
	    sdm_runspawncmd Burn1 b1script "$b1script"
	fi

	if [ "$plugins" != "" ]
	then
	    sdm_runspawncmd Burn1 run-plugin-list 1 "$plugins" || exit
	    sdm_runspawncmd Burn1 run-plugin-list post-install "$plugins" || exit
	    # Set lightdm burn enable delay if it was installed as part of burning
	    if ! ispluginselected x11 "$plugins"
	    then
		[ -d $SDMPT/etc/lightdm -a $xldm -eq 0 ] && sdm_runspawncmd Burn1 burn-enable-lightdm-delay
	    fi
	    loadparams       #Reread in case it got updated running plugins (e.g. myuser from user plugin)
	fi

	resetpluginlist
	#
	# Redact passwords if requested
	#
	if [[ $bfredact -eq 1 ]]
	then
	    write_burnmsg "> Redact passwords from /etc/sdm/cparams and /etc/sdm/history"
	    do_redactions
	    #runoneplugin user redact "redact"
	fi

	declare -x SDMNSPAWN="Burn0"
    else
	echo $"% IMG '$dimg' is not sdm-enhanced
  Logs and configuration updates will not be written"
	[ "$b0script" != "" ] && echo "  and b0script '$b0script' will not be processed"
	[ "$b1script" != "" ] && echo "  and b1script '$b1script' will not be processed"
	[ "$plugins" != "" ] && echo "   and plugins '$plugins' will not be processed"
	[ "$hname" != "" ] && updatehostname $hname
	if [[ $expandroot -eq 1 ]] && [[ "$burndev" != "" ]]
	then
	    docleanup keep
	    [ "cvtrootfs" != "zfs" ] && expandpartition $burndev 0 echo $cvtrootfs
	fi
	writediskids
	if [[ "$cvtrootfs" != "" ]] && [[ "$cvtrootfs" != "ext4" ]]
	then
	    errexit "? Sorry for the late notice but --convert-root requires an sdm-enhanced IMG"
	fi
    fi
    #
    # Install required packages for different rootfs file systems and do update-initramfs if needed
    #
    case "$cvtrootfs" in
	btrfs)
	    if [ ! -x $SDMPT/bin/btrfs ]
	    then
		write_burnmsg "> Install btrfs-progs onto burned disk"
		write_burnmsg ""
		write_burnmsg "  NOTE: Ignore 'Couldn't identify / resolve / etc' errors during update-initramfs"
		write_burnmsg ""
		sdm_runspawncmd Burn1 run-command "apt install --yes --no-install-recommends btrfs-progs"
	    else
		write_burnmsg "> Enable btrfs in initramfs"
		sdm_runspawncmd Burn1 run-update-initramfs
	    fi
	    ;;
	lvm)
	    if [ ! -x $SDMPT/sbin/lvcreate ]
	    then
		write_burnmsg "> Install lvm2 onto burned disk"
		sdm_runspawncmd Burn1 run-command "apt install --yes  --no-install-recommends lvm2"
	    else
		write_burnmsg "> Enable lvm in initramfs"
		sdm_runspawncmd Burn1 run-update-initramfs
	    fi
	    ;;
	zfs)
	    if [ ! -x $SDMPT/bin/zfs ]
	    then
		# Get the latest kernel version from /lib/modules/
		# List all kernel versions found in /lib/modules
		kernels=(/lib/modules/*)
		# Strip path, keep only version names
		versions=()
		for k in "${kernels[@]}"; do
		    versions+=("$(basename "$k")")
		done
		#echo "Found kernels:"
		#printf '  %s\n' "${versions[@]}"
		# Sort versions using natural version sort
		sorted_versions=$(printf '%s\n' "${versions[@]}" | sort -V)
		# Highest version is the last one
		highest_full=$(printf '%s\n' "$sorted_versions" | tail -n 1)
		#echo $highest_full
		highest_base=$(echo "$highest_full" | sed 's/[^0-9.].*$//')
		#echo "Highest base version: $highest_base"
		# Find all kernels whose version begins with the same numeric prefix
		matching=()
		kh=""
		for v in "${versions[@]}"; do
		    if [[ "$v" == "$highest_base"* ]]; then
			kh="$kh linux-headers-$v"
		    fi
		done

		cat > $SDMPT/root/do-zfs-dkms <<'EOF'
#!/bin/bash
function loadparams() {
    local arg="$1"
    source $SDMPT/etc/sdm/sdm-readparams $arg
}

loadparams
debconf-set-selections <<EDSS
zfs-dkms zfs-dkms/stop-build-for-unknown-kernel boolean false
zfs-dkms zfs-dkms/stop-build-for-32bit-kernel boolean false
zfs-dkms zfs-dkms/note-incompatible-licenses note true
EDSS
declare -x DKMS_SKIP_BUILD=1
doaptrpterror "install --yes  --no-install-recommends zfsutils-linux zfs-dkms zfs-zed zfs-initramfs $kh" 0
# Disable audit, which is enabled bc zfs
logtoboth "> Disable auditing enabled because of zfs rootfs"
systemctl mask auditd
systemctl mask systemd-journald-audit.socket
EOF
		chmod 755 $SDMPT/root/do-zfs-dkms
		write_burnmsg "> Install zfs software onto burned disk"
		write_burnmsg "  This will build and install a dkms module"
		write_burnmsg "  Expected build time: Pi5: 6-8 minutes"
		zfsstart=$(getcdate)
		write_burnmsg "> zfs install start: $(thisdate)"
		sdm_runspawncmd Burn1 run-command /root/do-zfs-dkms
		rm -f $SDMPT/root/do-zfs-dkms
	    else
		write_burnmsg "> Enable zfs in initramfs"
		sdm_runspawncmd Burn1 run-update-initramfs
	    fi
	    write_burnmsg "> zfs install end:   $(thisdate)"
	    write_burnmsg "> zfs install time:  $(datediff "$zfsstart" "$(getcdate)")"
    esac
    if [ -f $SDMPT/var/lib/systemd/timesync/clock ]
    then
	write_burnmsg "> Update /var/lib/systemd/timesync/clock to current time"
	touch $SDMPT/var/lib/systemd/timesync/clock
    fi
    write_burnmsg "> Burn elapsed time: $(datediff "$burnstart" "$(getcdate)")"
    write_burnmsg "* Burn Completed"
    printnotes
    [ "$extractlogdir" != "" ] && extractlogs
    #
    # Call burn-plugins
    #
    docleanup

    # Redefine logtoboth so it just does an "echo" as the log is inaccessible from now on
    function logtoboth() {
	echo "$1"
    }

    if [ "$burnplugins" != "" ]
    then
	logtoboth "* Run Post-Burn plugins"
	[ "$burndev" != "" ] && imgtype="Device"
	[ "$burnfilefile" != "" ] && imgtype="IMG"
	runplugins_exit "$burnplugins" burn-complete "burndev=$burndev|burnfilefile=$burnfilefile|imgtype=$imgtype"
    fi
