#!/bin/bash
#
# This is an sdm plugin for: mariadb
#
# The plugin is called three times: for Phase 0, Phase 1, and post-install.
#

function loadparams() {
    source $SDMPT/etc/sdm/sdm-readparams
}

# $1 is the phase: "0", "1", or "post-install"
# $2 is the argument list: arg1=val1|arg2=val2|arg3=val3| ...
#
# Main code for the Plugin
#
phase=$1
pfx="$(basename $0)"     #For messages
args="$2"
loadparams

vldargs="|mysql-dbadd|mysql-install|listen-all|mysql-root-password|"
rqdargs="|mysql-root-password|"
assetdir="$SDMPT/etc/sdm/assets/$pfx"

if [ "$phase" == "0" ]
then
    #
    # In Phase 0 all references to directories in the image must be preceded by $SDMPT
    #
    logtoboth "* Plugin $pfx: Start Phase 0"
    plugin_getargs $pfx "$args" "$vldargs" "$rqdargs" || exit
    plugin_printkeys
    mkdir -p $assetdir
    logtoboth "* Plugin $pfx: Complete Phase 0"
elif [ "$phase" == "1" ]
then
    #
    # Phase 1 (in nspawn)
    #
    logtoboth "* Plugin $pfx: Start Phase 1"
    plugin_getargs $pfx "$args" "$vldargs" "$rqdargs"
    logfreespace "at start of Plugin $pfx Phase 1"
    [[ ! -v mysql__install ]] && [[ ! -v mysql__dbadd ]] && logtoboth "% Plugin $pfx: Neither mysql-install nor mysql-dbadd specified; mysql-install assumed" && mysql__install=1
    if [ -v mysql__install ]
    then
	logtoboth "> Plugin $pfx: Install mariadb-server"
	installpkgsif "mariadb-server"

	printf "[client]\nuser = sdm\npassword = ${mysql__root__password}\nhost = localhost\n" > $assetdir/my.cnf
	chown 600 $assetdir/my.cnf
	wpsql=$assetdir/wp.sql

	echo "ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD('$mysql__root__password');" >| $wpsql
	echo "CREATE USER 'sdm'@'localhost' IDENTIFIED BY '$mysql__root__password';" >> $wpsql
	echo "CREATE USER 'sdm'@'%' IDENTIFIED BY '$mysql__root__password';" >> $wpsql
	echo "GRANT CREATE USER, GRANT OPTION ON *.* TO 'sdm'@'localhost';" >> $wpsql
	echo "GRANT CREATE USER, GRANT OPTION ON *.* TO 'sdm'@'%';" >> $wpsql
	echo "GRANT ALL PRIVILEGES ON *.* TO 'sdm'@'localhost';" >> $wpsql
	echo "GRANT ALL PRIVILEGES ON *.* TO 'sdm'@'%';" >> $wpsql
	echo "FLUSH PRIVILEGES;" >> $wpsql
	echo "exit" >> $wpsql
	logtoboth "> Plugin $pfx: Write SQL configuration script '$wpsql'"
	logfiletoboth $wpsql
	add_redaction "${mysql__root__password//$/\\$}"

	plugin_addnote "*** mariadb install notes"
	plugin_addnote ""

	if [ -v listen__all ]
	then
	    logtoboth "> Plugin $pfx: Configure mariadb to listen on all network interfaces"
	    sed -i '/bind-address.*=.*127.0.0.1/c\
#bind-address=127.0.0.1\
bind-address=0.0.0.0' /etc/mysql/mariadb.conf.d/50-server.cnf
	    # Restart service with updated configuration
	    systemd_running && systemctl -q restart mariadb
	fi

	if systemd_running
	then
	    logtoboth "> Plugin $pfx: Configure mariadb database root password using '$wpsql'"
	    mariadb -u root < $wpsql || logtobothex "? Plugin $pfx: Mariadb returned an error '$?'; Check the logs"
	    plugin_addnote "* mariadb installed and root user configured"
	    plugin_addnote "* Use the mariadb plugin with argument 'mysql-dbadd' to configure desired databases"
	    plugin_addnote ""
	else
	    logtoboth "% Plugin $pfx: Not running in a booted system or mariadb not running; cannot configure mariadb; see end of customization plugin notes"
	    plugin_addnote "* The mariadb plugin was unable to configure mariadb; system not booted or mariadb server not running"
	    plugin_addnote "* You must manually configure mariadb root user on running system via"
	    plugin_addnote ""
	    plugin_addnote "     sudo mariadb -u root < $wpsql"
	    plugin_addnote ""
	    
	fi
    fi
    if [[ -v mysql__dbadd ]] && [[ "$mysql__dbadd" != "" ]]
    then
	[ -f $assetdir/my.cnf ] || logtobothex "? Plugin $pfx: Unable to process; mariadb not installed by this plugin"
	IFS="," read dbname dbuser dbpwd remoteip <<< "$mysql__dbadd"
	[ "$remoteip" == "" ] && remoteip="%"
	dbfulluser="'$dbuser'@'$remoteip'"
	logtoboth "> Plugin $pfx: Add database '$dbname' and grant $dbfulluser full privileges to it"
	wpscript="$assetdir/wp-$dbname.sql"
	echo "CREATE USER $dbfulluser IDENTIFIED BY '$dbpwd';" >| $wpscript
	echo "GRANT ALL PRIVILEGES ON $dbname.* TO $dbfulluser;" >> $wpscript
	echo "FLUSH PRIVILEGES; " >> $wpscript
	if systemd_running
	then
	    logfiletoboth $wpscript
	    #logtoboth "mariadb --protocol=TCP -h 127.0.0.1 -u sdm -p${mysql__root__password} < $wpscript"
	    mariadb --protocol=TCP -h 127.0.0.1 -u sdm -p${mysql__root__password} < $wpscript
	    #This also works
	    #logtoboth "mariadb --defaults-file=$assetdir/my.cnf < $wpscript"
	    #mariadb --defaults-file=$assetdir/my.cnf < $wpscript
	else
	    plugin_addnote " * Configure the new database on this host when booted:"
	    plugin_addnote "   sudo mariadb -u sdm -p${mysql__root__password} < $wpscript"
	    #plugin_addnote "   sudo mariadb --protocol=TCP -h 127.0.0.1 -u sdm -p${mysql__root__password} < $wpscript"
	fi
    fi
    logfreespace "at end of $pfx Phase 1"
    logtoboth "* Plugin $pfx: Complete Phase 1"
elif [ "$phase" == "post-install" ]
then
    #
    # Plugin Post-install edits
    #
    logtoboth "* Plugin $pfx: Start Phase post-install"
    logtoboth "* Plugin $pfx: Complete Phase post-install"
fi

exit

